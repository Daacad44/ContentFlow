# Docker development overrides — copy to backend/.env.docker and fill secrets
NODE_ENV=development
PORT=4000
APP_NAME=ContentFlow
API_URL=http://localhost:4000
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/contentflow?schema=public
DIRECT_URL=postgresql://postgres:postgres@postgres:5432/contentflow?schema=public

JWT_ACCESS_SECRET=dev_access_secret_min_16_chars
JWT_REFRESH_SECRET=dev_refresh_secret_min_16_chars

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173/api/v1/auth/google/callback

REDIS_URL=redis://redis:6379
ENABLE_IN_PROCESS_SCHEDULER=false
REQUIRE_REDIS_IN_PRODUCTION=true
ALLOW_SIMULATED_PUBLISH=false

ZERNIO_API_KEY=
ZERNIO_API_URL=https://zernio.com/api/v1

GEMINI_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
