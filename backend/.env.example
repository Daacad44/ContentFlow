# ----------------------------------------------------------------------------
# APPLICATION
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
APP_NAME=ContentFlow
# Public URL of the API (browser-facing — use your Vercel/custom domain when proxied)
API_URL=https://contentflow.botandev.com
# Publicly reachable API URL for media uploads (Zernio must fetch images/videos)
PUBLIC_API_URL=
# Public URL of the frontend (default OAuth redirect + email links)
CLIENT_URL=https://contentflow.botandev.com

# ----------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# ----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/contentflow?schema=public"
# Direct connection for migrations (same as DATABASE_URL locally).
# Supabase: DATABASE_URL = Transaction pooler URI (port 6543) + "?pgbouncer=true&connection_limit=1"
#           DIRECT_URL   = Session pooler / direct URI (port 5432)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/contentflow?schema=public"

# ----------------------------------------------------------------------------
# JWT / TOKENS
# Generate strong secrets, e.g.: openssl rand -base64 48
# ----------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Cookie name for the refresh token
REFRESH_COOKIE_NAME=cf_refresh_token
# Issuer / audience claims
JWT_ISSUER=contentflow.api
JWT_AUDIENCE=contentflow.client

# ----------------------------------------------------------------------------
# GOOGLE OAUTH
# https://console.cloud.google.com/apis/credentials
# ----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Register ALL of these in Google Cloud Console → OAuth client → Authorized redirect URIs:
#   http://localhost:4000/api/v1/auth/google/callback
#   http://localhost:5173/api/v1/auth/google/callback  (Vite dev proxy)
#   https://contentflow.botandev.com/api/v1/auth/google/callback
# Authorized JavaScript origins (same client):
#   http://localhost:5173
#   https://contentflow.botandev.com
GOOGLE_CALLBACK_URL=https://contentflow.botandev.com/api/v1/auth/google/callback

# ----------------------------------------------------------------------------
# EMAIL — Resend (https://resend.com) · domain: botandev.com
# ----------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="BotanDev <noreply@botandev.com>"
EMAIL_BRAND_NAME=BotanDev

# OTP settings
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_PEPPER=

# ----------------------------------------------------------------------------
# SECURITY
# ----------------------------------------------------------------------------
# Comma separated list of allowed CORS origins (frontend URLs)
CORS_ORIGINS=http://localhost:5173,https://contentflow.botandev.com
# Cross-origin SPA (Vercel + separate API): cookies use SameSite=None automatically
# COOKIE_SAME_SITE=none
# For local dev with Vite proxy (/api/v1 → backend), use lax cookies:
# COOKIE_SAME_SITE=lax
# Bcrypt/argon pepper appended to every password before hashing (optional)
PASSWORD_PEPPER=
# Lockout policy
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ----------------------------------------------------------------------------
# ZERNIO API (Social account integration)
# https://docs.zernio.com/
# ----------------------------------------------------------------------------
ZERNIO_API_KEY=
ZERNIO_API_URL=https://zernio.com/api/v1
# 32+ char secret for encrypting platform tokens at rest (optional)
TOKEN_ENCRYPTION_KEY=

# ----------------------------------------------------------------------------
# MEDIA UPLOADS
# ----------------------------------------------------------------------------
# Post media storage: auto | supabase | cloudinary | local
#   auto       → Supabase when SUPABASE_* is set, else Cloudinary when CLOUDINARY_* is set, else local disk
#   supabase   → Supabase Storage public bucket (recommended on Vercel + Supabase)
#   cloudinary → Cloudinary (files survive redeploys; public HTTPS URLs for Zernio)
#   local      → server disk under UPLOAD_DIR (development only; not available on Vercel)
MEDIA_STORAGE=auto
# Supabase → Project Settings → API. The service-role key is secret: server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=post-media
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# ----------------------------------------------------------------------------
# REDIS / BULLMQ (Publishing Engine — required in production)
# Leave REDIS_URL blank in local dev only if ENABLE_IN_PROCESS_SCHEDULER=true
# Serverless (Vercel): no Redis/worker. Scheduled posts are published by calling
# GET /api/v1/internal/cron/publish-due with "Authorization: Bearer $CRON_SECRET"
# (Supabase pg_cron every minute, or Vercel Cron). Generate with: openssl rand -hex 32
CRON_SECRET=
# ----------------------------------------------------------------------------
REDIS_URL=
BULLMQ_PREFIX=contentflow
PUBLISH_MAX_ATTEMPTS=3
PUBLISH_WORKER_CONCURRENCY=5
ENABLE_IN_PROCESS_SCHEDULER=true
# Serverless (Vercel): no Redis/worker. Scheduled posts are published by calling
# GET /api/v1/internal/cron/publish-due with "Authorization: Bearer $CRON_SECRET"
# (Supabase pg_cron every minute, or Vercel Cron). Generate with: openssl rand -hex 32
CRON_SECRET=
REQUIRE_REDIS_IN_PRODUCTION=true
ALLOW_SIMULATED_PUBLISH=false
PUBLISH_CONFIRM_POLL_MS=5000
PUBLISH_CONFIRM_MAX_ATTEMPTS=12

# ----------------------------------------------------------------------------
# GEMINI AI (Content Generation — Agent 06)
# https://aistudio.google.com/apikey
# ----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ----------------------------------------------------------------------------
# CLOUDINARY (Creative Studio — Agent 07)
# https://cloudinary.com/console
# ----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ----------------------------------------------------------------------------
# STRIPE (Billing — Agent 10)
# https://dashboard.stripe.com/apikeys
# ----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# Price IDs from Stripe → Products (needed for upgrades to Pro / Business)
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
# Block actions over the plan's monthly limits (usage is tracked either way).
# Enable after STRIPE_PRICE_* are set so users can upgrade.
ENFORCE_PLAN_LIMITS=false
