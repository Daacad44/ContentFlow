# ----------------------------------------------------------------------------
# APPLICATION
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
APP_NAME=ContentFlow
# Public URL of the API (used in email links, OAuth callbacks)
API_URL=http://localhost:4000
# Public URL of the frontend (used in email links & CORS)
CLIENT_URL=http://localhost:5173

# ----------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# ----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/contentflow?schema=public"

# ----------------------------------------------------------------------------
# JWT / TOKENS
# Generate strong secrets, e.g.: openssl rand -base64 48
# ----------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Cookie name for the refresh token
REFRESH_COOKIE_NAME=cf_refresh_token
# Issuer / audience claims
JWT_ISSUER=contentflow.api
JWT_AUDIENCE=contentflow.client

# ----------------------------------------------------------------------------
# GOOGLE OAUTH
# https://console.cloud.google.com/apis/credentials
# ----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# ----------------------------------------------------------------------------
# EMAIL (SMTP)
# For local dev use Mailtrap / Ethereal. Leave blank to log emails to console.
# ----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ContentFlow <no-reply@contentflow.ai>"

# ----------------------------------------------------------------------------
# SECURITY
# ----------------------------------------------------------------------------
# Comma separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173
# Bcrypt/argon pepper appended to every password before hashing (optional)
PASSWORD_PEPPER=
# Lockout policy
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ----------------------------------------------------------------------------
# ZERNIO API (Social account integration)
# https://docs.zernio.com/
# ----------------------------------------------------------------------------
ZERNIO_API_KEY=
ZERNIO_API_URL=https://zernio.com/api/v1
# 32+ char secret for encrypting platform tokens at rest (optional)
TOKEN_ENCRYPTION_KEY=
