# Local dev — browser hits Next.js proxy → localhost:4000
NEXT_PUBLIC_API_URL=/api/v1
API_PROXY_URL=http://localhost:4000

# Vercel production — set in Project → Settings → Environment Variables:
# NEXT_PUBLIC_API_URL=/api/v1
# API_PROXY_URL=https://YOUR_NGROK_OR_BACKEND_URL   (no trailing slash)
# Register in Google Console:
#   https://content-flow-black.vercel.app/api/v1/auth/google/callback
